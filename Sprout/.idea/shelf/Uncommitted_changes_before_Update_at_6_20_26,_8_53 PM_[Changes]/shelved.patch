+package com.example.final_ui_skeleton
+
+import androidx.compose.runtime.Composable
+import androidx.navigation.compose.NavHost
+import androidx.navigation.compose.composable
+import androidx.navigation.compose.rememberNavController
+import com.example.final_ui_skeleton.ui.screens.*
+
+/**
+ * 1. What: Defines all navigation routes and wires screens together.
+ * 2. Who: Called from MainActivity as the root composable.
+ * 3. When: Executed at app startup to set up the nav graph.
+ */
+@Composable
+fun SproutNavGraph() {
+    val navController = rememberNavController()
+
+    NavHost(navController = navController, startDestination = "welcome") {
+
+        composable("welcome") {
+            WelcomeScreen(
+                onContinue = { navController.navigate("signIn") }
+            )
+        }
+
+        composable("signIn") {
+            SignInScreen(
+                onSignIn = { navController.navigate("dashboard") {
+                    popUpTo("welcome") { inclusive = true }
+                }},
+                onCreateAccount = { navController.navigate("basicInfo") }
+            )
+        }
+
+        composable("basicInfo") {
+            BasicInformationScreen(
+                onSuccess = { navController.navigate("demographic") },
+                onBack = { navController.popBackStack() }
+            )
+        }
+
+        composable("demographic") {
+            DemographicScreen(
+                onGotchaClick = { navController.navigate("dashboard") {
+                    popUpTo("welcome") { inclusive = true }
+                }}
+            )
+        }
+
+        composable("dashboard") {
+            DashboardScreen(
+                onNavigateBudgets = { navController.navigate("budgets") },
+                onNavigateRecommend = { navController.navigate("recommend") },
+                onNavigateSettings = { navController.navigate("settings") }
+            )
+        }
+
+        composable("budgets") {
+            BudgetSnapshotScreen(
+                onNavigateDashboard = { navController.navigate("dashboard") },
+                onNavigateRecommend = { navController.navigate("recommend") },
+                onNavigateSettings = { navController.navigate("settings") }
+            )
+        }
+
+        composable("recommend") {
+            AIRecommendationsScreen(
+                onNavigateDashboard = { navController.navigate("dashboard") },
+                onNavigateBudgets = { navController.navigate("budgets") },
+                onNavigateSettings = { navController.navigate("settings") }
+            )
+        }
+
+        composable("settings") {
+            SettingsScreen(
+                onLogout = { navController.navigate("signIn") {
+                    popUpTo("welcome") { inclusive = true }
+                }},
+                onNavigateDashboard = { navController.navigate("dashboard") },
+                onNavigateBudgets = { navController.navigate("budgets") },
+                onNavigateRecommend = { navController.navigate("recommend") }
+            )
+        }
+    }
+}
