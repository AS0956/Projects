tDest) {\n\n        composable(\"welcome\") {\n            WelcomeScreen(onContinue = { navController.navigate(\"signin\") })\n        }\n\n        composable(\"signin\") {\n            SignInScreen(\n                viewModel = viewModel,\n                onSignIn = {\n                    navController.navigate(\"dashboard\") {\n                        popUpTo(\"welcome\") { inclusive = true }\n                    }\n                },\n                onGoogle = {},\n                onApple = {},\n                onCreateAccount = { navController.navigate(\"basicinfo\") }\n            )\n        }\n\n        composable(\"basicinfo\") {\n            BasicInformationScreen(\n                viewModel = viewModel,\n                onSuccess = {\n                    navController.navigate(\"demographic\") {\n                        popUpTo(\"welcome\") { inclusive = true }\n                    }\n                }\n            )\n        }\n\n        composable(\"demographic\") {\n            DemographicScreen(\n                viewModel = viewModel,\n                onGotchaClick = { navController.navigate(\"savingsgoal\") }\n            )\n        }\n\n        composable(\"savingsgoal\") {\n            SavingsGoalScreen(onNext = { navController.navigate(\"privacy\") })\n        }\n\n        composable(\"privacy\") {\n            PrivacyScreen(onTakeHome = {\n                navController.navigate(\"dashboard\") {\n                    popUpTo(\"welcome\") { inclusive = true }\n                }\n            })\n        }\n\n        composable(\"dashboard\") {\n            DashboardScreen(viewModel = viewModel, navController = navController)\n        }\n\n        composable(\"budgets\") {\n            SpendingHistoryScreen(viewModel = viewModel, navController = navController)\n        }\n\n        composable(\"addexpense\") {\n            AddExpenseScreen(viewModel = viewModel, navController = navController)\n        }\n\n        composable(\"recommendations\") {\n            AIRecommendationsScreen(navController = navController)\n        }\n\n        composable(\"settings\") {\n            SettingsScreen(\n                viewModel = viewModel,\n                onLogout = {\n                    navController.navigate(\"welcome\") {\n                        popUpTo(\"dashboard\") { inclusive = true }\n                    }\n                }\n            )\n        }\n    }\n}
